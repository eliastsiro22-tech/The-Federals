# =============================================================
# Force of Nature (IndicatorFON)
# thinkorswim thinkScript study  |  chart overlay
# -------------------------------------------------------------
# Highest-probability Fib ratios only + Golden Pocket emphasis
# + Fib Time/Cycles + Anchored VWAP + Fan proximity
# + HTF Trend + Quality PA + Volume + RSI Extreme/Divergence
# Rare, high-confidence signals only
# =============================================================

declare upper;

input showSignals           = yes;
input confluenceThreshold   = 7.0;      # Weighted score threshold (7.0 = two pockets agree)
input toleranceATR          = 0.15;     # proximity band floor, ATR multiple
input toleranceRangePct     = 0.02;     # proximity band as fraction of each grid's range
input avwapBandATR          = 0.25;     # AVWAP proximity band, ATR multiple
input minContextGates       = 1;        # of: time window, AVWAP, fan (0-3)
input armedWindowBars       = 5;        # trigger accepted while armed within last N bars
input requireHTFGrid        = no;       # arm only if daily/weekly grids contribute >= 3.5 (big-structure signals)
input gapGuard              = no;       # block counter-gap signals after a fresh large session gap
input gapATRmult            = 3.0;      # gap size threshold, ATR multiple
input gapStandDownBars      = 35;       # ~5 RTH days on a 1h chart
input cooldownBars          = 10;       # bars to stand down after a signal
input timeToleranceBars     = 2;
input minSwingATR           = 1.5;
input lookback1H            = 24;       # 1H grid: last N hourly bars
input lookback4H            = 30;       # 4H grid: last N 4-hour bars
input lookbackD             = 20;       # Daily grid: last N days
input lookbackW             = 13;       # Weekly grid: last N weeks
input requireVolume         = no;       # advisory by default: the 1.3x surge vetoed ~100% of real 1h setups
input volumeMult            = 1.3;
input requireHTFTrend       = yes;
input htfAgg                = AggregationPeriod.DAY;
input requireRSI            = yes;
input rsiLength             = 14;
input rsiLookback           = 10;       # RSI extreme within last N bars counts
input rsiOversold           = 40;
input rsiOverbought         = 60;
input showDashboard         = yes;
input showAVWAP             = yes;

def na = Double.NaN;
def bn = BarNumber();
def atr = Average(TrueRange(high, close, low), 14);
def tolFloor = atr * toleranceATR;
def volAvg = Average(volume, 20);

# ---------- Improved Significant Swing Detection ----------
script getSwingHigh {
    input price = high;
    input left = 5;
    input right = 5;
    input minSize = 0.0;
    def isSwing = price[left] == Highest(price, left + right + 1) and
                  (price[left] - Lowest(price, left + right + 1)) >= minSize;
    plot out = if isSwing then price[left] else Double.NaN;
}

script getSwingLow {
    input price = low;
    input left = 5;
    input right = 5;
    input minSize = 0.0;
    def isSwing = price[left] == Lowest(price, left + right + 1) and
                  (Highest(price, left + right + 1) - price[left]) >= minSize;
    plot out = if isSwing then price[left] else Double.NaN;
}

def minSizeMain = atr * minSwingATR;
def shMain = getSwingHigh(high, 5, 5, minSizeMain);
def slMain = getSwingLow(low, 5, 5, minSizeMain);

# Alternate swings so the tracked high/low pair is always one real leg: an
# opposite-side pivot starts a new leg; a same-side pivot only counts if it
# is more extreme than the current leg extreme
def swingDir = if !IsNaN(shMain) and IsNaN(slMain) then 1
               else if !IsNaN(slMain) and IsNaN(shMain) then -1
               else swingDir[1];
def lastSwingHigh    = if !IsNaN(shMain) and (swingDir[1] != 1 or shMain >= lastSwingHigh[1]) then shMain else lastSwingHigh[1];
def lastSwingHighBar = if !IsNaN(shMain) and (swingDir[1] != 1 or shMain >= lastSwingHigh[1]) then bn - 5 else lastSwingHighBar[1];
def lastSwingLow     = if !IsNaN(slMain) and (swingDir[1] != -1 or slMain <= lastSwingLow[1]) then slMain else lastSwingLow[1];
def lastSwingLowBar  = if !IsNaN(slMain) and (swingDir[1] != -1 or slMain <= lastSwingLow[1]) then bn - 5 else lastSwingLowBar[1];

def lastSwingBar = Max(lastSwingHighBar, lastSwingLowBar);
def prevSwingBar = Min(lastSwingHighBar, lastSwingLowBar);
def isUpSwing    = lastSwingHighBar > lastSwingLowBar;

# ---------- Key Higher Timeframe Ranges ----------
# Each timeframe's fib grid is anchored to its recent trading range (the
# last N bars of that timeframe). Highest/Lowest are computed inline on the
# secondary aggregation so the lengths count HTF bars, not chart bars.
# This replaces the old HighestAll whole-chart scan: grids are now genuinely
# timeframe-distinct, independent of how much history is loaded, and do not
# repaint when a new chart-wide extreme prints later.
def shD  = Highest(high(period = AggregationPeriod.DAY),        lookbackD);
def slD  = Lowest(low(period   = AggregationPeriod.DAY),        lookbackD);
def sh4H = Highest(high(period = AggregationPeriod.FOUR_HOURS), lookback4H);
def sl4H = Lowest(low(period   = AggregationPeriod.FOUR_HOURS), lookback4H);
def sh1H = Highest(high(period = AggregationPeriod.HOUR),       lookback1H);
def sl1H = Lowest(low(period   = AggregationPeriod.HOUR),       lookback1H);
def shW  = Highest(high(period = AggregationPeriod.WEEK),       lookbackW);
def slW  = Lowest(low(period   = AggregationPeriod.WEEK),       lookbackW);

# ---------- Weighted Fib Score (Golden Pocket emphasis) ----------
script fibScore {
    input hi = 0.0;
    input lo = 0.0;
    input price = close;
    input tol = 0.0;

    def range = hi - lo;
    def f35   = lo + 0.350 * range;
    def f382  = lo + 0.382 * range;
    def f50   = lo + 0.500 * range;
    def f618  = lo + 0.618 * range;
    def f65   = lo + 0.650 * range;
    def f127u = hi + 0.272 * range;
    def f161u = hi + 0.618 * range;
    def f127d = lo - 0.272 * range;
    def f161d = lo - 0.618 * range;

    # golden pocket (0.618-0.65 up from the low) and its bearish mirror
    # (0.35-0.382, the same pocket measured down from the high) score
    # equally, so short setups are not structurally under-weighted;
    # extensions exist on both sides of the range
    def inGoldenPocket = price >= f618 and price <= f65;
    def inBearPocket   = price >= f35 and price <= f382;

    def s =
        (if AbsValue(price - f618) <= tol or inGoldenPocket then 3.5 else 0.0) +
        (if AbsValue(price - f382) <= tol or inBearPocket then 3.5 else 0.0) +
        (if AbsValue(price - f50)  <= tol then 2.5 else 0.0) +
        (if AbsValue(price - f127u) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f161u) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f127d) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f161d) <= tol then 1.5 else 0.0);
    # NaN guard: a timeframe with no qualifying swings must contribute 0 —
    # otherwise NaN poisons the summed score and silently disables every
    # signal on the chart (Score shows N/A in the dashboard)
    plot out = if IsNaN(range) or IsNaN(tol) then 0.0 else s;
}

# per-grid tolerance: ATR floor, widened proportionally for bigger ranges —
# a weekly level deserves a wider band than a 1-hour level
def tolMain = Max(tolFloor, (lastSwingHigh - lastSwingLow) * toleranceRangePct);
def tolD    = Max(tolFloor, (shD - slD)   * toleranceRangePct);
def tol4H   = Max(tolFloor, (sh4H - sl4H) * toleranceRangePct);
def tol1H   = Max(tolFloor, (sh1H - sl1H) * toleranceRangePct);
def tolW    = Max(tolFloor, (shW - slW)   * toleranceRangePct);

def scoreD     = fibScore(shD,  slD,  close, tolD);
def score4H    = fibScore(sh4H, sl4H, close, tol4H);
def score1H    = fibScore(sh1H, sl1H, close, tol1H);
def scoreW     = fibScore(shW,  slW,  close, tolW);
def scoreMain  = fibScore(lastSwingHigh, lastSwingLow, close, tolMain);

def priceConfluenceScore = scoreD + score4H + score1H + scoreW + scoreMain;
def isPriceConfluence    = priceConfluenceScore >= confluenceThreshold;

# ---------- Fib Time + Cycle Windows ----------
def span = Max(lastSwingBar - prevSwingBar, 1);
def t382 = lastSwingBar + Round(span * 0.382);
def t500 = lastSwingBar + Round(span * 0.500);
def t618 = lastSwingBar + Round(span * 0.618);
def t100 = lastSwingBar + span;
def t161 = lastSwingBar + Round(span * 1.618);

# windows only mean something on a real leg (span >= 8) and their tolerance
# scales with the leg duration instead of a fixed bar count
def timeTol = Max(timeToleranceBars, Round(span * 0.05, 0));
def isTimeWindow =
    span >= 8 and
    (AbsValue(bn - t382) <= timeTol or
     AbsValue(bn - t500) <= timeTol or
     AbsValue(bn - t618) <= timeTol or
     AbsValue(bn - t100) <= timeTol or
     AbsValue(bn - t161) <= timeTol);

# ---------- Anchored VWAP ----------
# Sum() requires a constant length in thinkScript, so the anchored sums are
# accumulated recursively. A new anchor always confirms exactly 5 bars after
# its pivot, so the window re-seeds with the last 6 bars.
def newAnchor = CompoundValue(1, lastSwingBar != lastSwingBar[1], no);
def cumPV = if newAnchor then Sum(close * volume, 6) else cumPV[1] + close * volume;
def cumV  = if newAnchor then Sum(volume, 6) else cumV[1] + volume;
def avwap = if bn >= lastSwingBar and cumV != 0 then cumPV / cumV else na;
def nearAVWAP = AbsValue(close - avwap) <= atr * avwapBandATR;

# ---------- Fibonacci Fan Proximity ----------
def fanRange = lastSwingHigh - lastSwingLow;
def fanSlope = fanRange / span;

def fan382 = if isUpSwing then lastSwingLow + fanSlope * 0.382 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.382 * (bn - lastSwingHighBar);
def fan50  = if isUpSwing then lastSwingLow + fanSlope * 0.500 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.500 * (bn - lastSwingHighBar);
def fan618 = if isUpSwing then lastSwingLow + fanSlope * 0.618 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.618 * (bn - lastSwingHighBar);

def nearFan = AbsValue(close - fan382) <= tolMain or
              AbsValue(close - fan50)  <= tolMain or
              AbsValue(close - fan618) <= tolMain;

# ---------- HTF Trend Filter ----------
# The EMA must be computed inline on the secondary aggregation: storing the
# series in a def first flattens it to chart bars, which yields a much
# faster pseudo-EMA instead of a true 21-period EMA of the higher timeframe
def htfClose = close(period = htfAgg);
def htfEMA   = ExpAverage(close(period = htfAgg), 21);
# NaN guard: with too little history for the EMA (needs 21 HTF bars) the
# trend is unknown — show "─" and block cleanly instead of NaN-poisoning
def htfTrendUp   = !IsNaN(htfEMA) and htfClose > htfEMA;
def htfTrendDown = !IsNaN(htfEMA) and htfClose < htfEMA;

# ---------- Quality Price Action + Volume ----------
def bullPA = low < low[1] and close > open and close > close[1] and
             (close - low) > 0.60 * (high - low);
def bearPA = high > high[1] and close < open and close < close[1] and
             (high - close) > 0.60 * (high - low);

def volOK = !requireVolume or volume > volAvg * volumeMult;

# ---------- RSI Extreme + Simple Regular Divergence ----------
def rsi = RSI(length = rsiLength);

# recent extreme: same-bar RSI is anti-correlated with zone-sitting (by the
# time price stabilizes at a level, RSI has mean-reverted), so the gate asks
# whether RSI visited the extreme within the last rsiLookback bars
def rsiExtremeBull = Lowest(rsi, rsiLookback) <= rsiOversold;
def rsiExtremeBear = Highest(rsi, rsiLookback) >= rsiOverbought;

# Regular divergence measured swing-to-swing: price sets a lower low while
# RSI at those two swing lows sets a higher low (mirrored for bearish).
# The original compared price lows against same-bar 6-bar RSI highs — a
# near-contradiction that could never fire.
def swingLowPrice     = if !IsNaN(slMain) then slMain else swingLowPrice[1];
def swingLowRsi       = if !IsNaN(slMain) then rsi[5] else swingLowRsi[1];
def prevSwingLowPrice = if !IsNaN(slMain) then swingLowPrice[1] else prevSwingLowPrice[1];
def prevSwingLowRsi   = if !IsNaN(slMain) then swingLowRsi[1] else prevSwingLowRsi[1];
def bullDiv = !IsNaN(swingLowRsi) and !IsNaN(prevSwingLowRsi) and prevSwingLowPrice != 0 and swingLowPrice < prevSwingLowPrice and swingLowRsi > prevSwingLowRsi;

def swingHighPrice     = if !IsNaN(shMain) then shMain else swingHighPrice[1];
def swingHighRsi       = if !IsNaN(shMain) then rsi[5] else swingHighRsi[1];
def prevSwingHighPrice = if !IsNaN(shMain) then swingHighPrice[1] else prevSwingHighPrice[1];
def prevSwingHighRsi   = if !IsNaN(shMain) then swingHighRsi[1] else prevSwingHighRsi[1];
def bearDiv = !IsNaN(swingHighRsi) and !IsNaN(prevSwingHighRsi) and prevSwingHighPrice != 0 and swingHighPrice > prevSwingHighPrice and swingHighRsi < prevSwingHighRsi;

def rsiBullOK = !requireRSI or rsiExtremeBull or bullDiv;
def rsiBearOK = !requireRSI or rsiExtremeBear or bearDiv;

# ---------- FULL HIGH-CONVICTION CONFLUENCE ----------
# time window, AVWAP and fan act as context votes (K of 3). The armed state
# (score + context + RSI + trend) is a multi-bar condition; the trigger bar
# (price action + optional volume) is a one-bar event. Requiring both on the
# same bar multiplied a ~2% event into a ~never event (measured over 7
# symbol-months of hourly data), so a signal fires when the trigger prints
# while the side was armed within the last armedWindowBars bars.
def contextCount = (if isTimeWindow then 1 else 0) + (if nearAVWAP then 1 else 0) + (if nearFan then 1 else 0);
def contextOK = contextCount >= minContextGates;

def htfGridOK = !requireHTFGrid or scoreD + scoreW >= 3.5;

def bullArmed = isPriceConfluence and contextOK and rsiBullOK and htfGridOK and (!requireHTFTrend or htfTrendUp);
def bearArmed = isPriceConfluence and contextOK and rsiBearOK and htfGridOK and (!requireHTFTrend or htfTrendDown);

def bullArmedRecent = Highest(if bullArmed then 1 else 0, armedWindowBars + 1) > 0;
def bearArmedRecent = Highest(if bearArmed then 1 else 0, armedWindowBars + 1) > 0;

# optional counter-gap stand-down: a large session gap invalidates the
# range statistics the grids were built from; block mean-reversion signals
# against the gap's direction for a while (off by default — it also blocks
# some legitimate post-gap fades, measured on 14 symbol-months)
def sessionGap = AbsValue(open - close[1]) > atr * gapATRmult;
def lastGapDnBar = if sessionGap and open < close[1] then bn else lastGapDnBar[1];
def lastGapUpBar = if sessionGap and open > close[1] then bn else lastGapUpBar[1];
def gapBlockBull = gapGuard and lastGapDnBar > 0 and bn - lastGapDnBar <= gapStandDownBars;
def gapBlockBear = gapGuard and lastGapUpBar > 0 and bn - lastGapUpBar <= gapStandDownBars;

# trigger-time trend re-check: the armed window lets the TRIGGER lag the
# setup, not the market state rot — in a fast decline price can slide below
# the trend EMA between arming and trigger (the knife-catch failure mode);
# measured cost of re-asserting trend at the trigger: ~1 signal in 13
def bullConfluence = bullArmedRecent and bullPA and volOK and (!requireHTFTrend or htfTrendUp) and !gapBlockBull;
def bearConfluence = bearArmedRecent and bearPA and volOK and (!requireHTFTrend or htfTrendDown) and !gapBlockBear;

# suppress signal clusters: once a signal fires, stand down for N bars
def lastSigBar = if (bullConfluence or bearConfluence) and bn - lastSigBar[1] > cooldownBars then bn else lastSigBar[1];
def canFire = bn - lastSigBar[1] > cooldownBars;

# ---------- Signals ----------
plot BullSignal = if showSignals and bullConfluence and canFire then low - atr * 0.45 else na;
BullSignal.SetPaintingStrategy(PaintingStrategy.ARROW_UP);
BullSignal.SetDefaultColor(Color.CYAN);
BullSignal.SetLineWeight(4);

plot BearSignal = if showSignals and bearConfluence and canFire then high + atr * 0.45 else na;
BearSignal.SetPaintingStrategy(PaintingStrategy.ARROW_DOWN);
BearSignal.SetDefaultColor(Color.MAGENTA);
BearSignal.SetLineWeight(4);

# ---------- Anchored VWAP Line ----------
plot AVWAPLine = if showAVWAP then avwap else na;
AVWAPLine.SetDefaultColor(Color.YELLOW);
AVWAPLine.SetStyle(Curve.SHORT_DASH);
AVWAPLine.SetLineWeight(2);

# ---------- Dashboard ----------
AddLabel(showDashboard,
    "Score: " + Round(priceConfluenceScore, 1) +
    " | Time: " + (if isTimeWindow then "✓" else "×") +
    " | AVWAP: " + (if nearAVWAP then "✓" else "×") +
    " | Fan: " + (if nearFan then "✓" else "×") +
    " | RSI: " + (if (bullConfluence or bearConfluence) then "✓" else if rsiBullOK or rsiBearOK then "·" else "×") +
    " | HTF: " + (if htfTrendUp then "▲" else if htfTrendDown then "▼" else "─"),
    if bullConfluence or bearConfluence then Color.GREEN else Color.GRAY
);
