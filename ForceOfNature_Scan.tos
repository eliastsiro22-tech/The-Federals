# =============================================================
# Force of Nature — Scan pre-filter (thinkorswim Stock Hacker)
# -------------------------------------------------------------
# Lean single-aggregation pre-filter. The scan engine enforces a much
# smaller complexity budget than charts (TooComplexException), so this
# version keeps only the cheap, recursion-free core:
#   multi-range fib-zone confluence + RSI + trend (+ trigger bar in
#   Signal mode)
# Swing structure, fan, time windows, anchored VWAP and divergence are
# chart-study concerns — confirm scan hits on ForceOfNature.tos / .pine.
#
# Usage: Scan tab -> Stock Hacker -> Add study filter -> pencil ->
# thinkScript Editor -> paste -> set the filter's aggregation to 1h.
# mode = Armed:  price sitting in fib zones with RSI + trend aligned,
#                awaiting a trigger bar (build a watchlist from these)
# mode = Signal: trigger bar (price action + volume) present as well
# =============================================================

input mode                = {default Armed, Signal};
input direction           = {default Either, Bull, Bear};
input minZoneHits         = 2;      # grids (of 3) whose zone contains price
input toleranceATR        = 0.25;   # band around each grid's 50% level
input lookback1H          = 24;     # chart bars (run the filter at 1h)
input lookback4H          = 120;    # ~30 four-hour bars, in 1h RTH bars
input lookbackD           = 140;    # ~20 days, in 1h RTH bars
input requireVolume       = yes;
input volumeMult          = 1.3;
input requireHTFTrend     = yes;
input trendLen            = 150;    # ~21 days of 1h RTH bars (daily EMA proxy)
input requireRSI          = yes;
input rsiLength           = 14;
input rsiOversold         = 40;
input rsiOverbought       = 60;

def atr = Average(TrueRange(high, close, low), 14);
def tol = atr * toleranceATR;
def volAvg = Average(volume, 20);

# ---------- Range grids (chart-bar approximations of 1H / 4H / D) ----------
def h1 = Highest(high, lookback1H);
def l1 = Lowest(low, lookback1H);
def h4 = Highest(high, lookback4H);
def l4 = Lowest(low, lookback4H);
def hd = Highest(high, lookbackD);
def ld = Lowest(low, lookbackD);

# zone test per grid: golden pocket (0.618-0.650), bear pocket
# (0.350-0.382), or the 50% level within tolerance
def r1 = h1 - l1;
def z1 = (close >= l1 + 0.618 * r1 and close <= l1 + 0.650 * r1) or
         (close >= l1 + 0.350 * r1 and close <= l1 + 0.382 * r1) or
         AbsValue(close - (l1 + 0.500 * r1)) <= tol;

def r4 = h4 - l4;
def z4 = (close >= l4 + 0.618 * r4 and close <= l4 + 0.650 * r4) or
         (close >= l4 + 0.350 * r4 and close <= l4 + 0.382 * r4) or
         AbsValue(close - (l4 + 0.500 * r4)) <= tol;

def rd = hd - ld;
def zd = (close >= ld + 0.618 * rd and close <= ld + 0.650 * rd) or
         (close >= ld + 0.350 * rd and close <= ld + 0.382 * rd) or
         AbsValue(close - (ld + 0.500 * rd)) <= tol;

def zoneHits = (if z1 then 1 else 0) + (if z4 then 1 else 0) + (if zd then 1 else 0);
def inZones = zoneHits >= minZoneHits;

# ---------- Trend proxy, RSI, trigger bar ----------
def htfEMA = ExpAverage(close, trendLen);
def rsi = RSI(length = rsiLength);

def bullPA = low < low[1] and close > open and close > close[1] and
             (close - low) > 0.60 * (high - low);
def bearPA = high > high[1] and close < open and close < close[1] and
             (high - close) > 0.60 * (high - low);
def volOK = !requireVolume or volume > volAvg * volumeMult;

# ---------- Assembly ----------
def bullArmed = inZones and (!requireRSI or rsi <= rsiOversold) and (!requireHTFTrend or close > htfEMA);
def bearArmed = inZones and (!requireRSI or rsi >= rsiOverbought) and (!requireHTFTrend or close < htfEMA);

def bullPick = if mode == mode.Armed then bullArmed else bullArmed and bullPA and volOK;
def bearPick = if mode == mode.Armed then bearArmed else bearArmed and bearPA and volOK;

def dirBull = direction == direction.Bull or direction == direction.Either;
def dirBear = direction == direction.Bear or direction == direction.Either;

plot scan = (dirBull and bullPick) or (dirBear and bearPick);
