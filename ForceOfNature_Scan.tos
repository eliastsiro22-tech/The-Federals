# =============================================================
# Force of Nature — Scan version (thinkorswim Stock Hacker)
# -------------------------------------------------------------
# Single-aggregation adaptation of ForceOfNature.tos for the scanner.
# thinkorswim scans do not allow secondary aggregations, so the higher-
# timeframe grids are approximated with chart-bar lookbacks and the daily
# trend EMA with a long chart-bar EMA. Run the scan filter at the 1h
# aggregation for the closest match to the chart study.
#
# Differences vs the chart study (unavoidable in a scan):
#  - Weekly grid omitted (too much history for a scan window), so the
#    default score threshold is reduced from 7.5 to 6.0
#  - 4H / daily lookbacks are approximated in 1h bars assuming regular
#    trading hours (~7 bars/day); adjust if scanning extended hours
#  - No cooldown (a scan is a point-in-time snapshot)
#
# mode = Signal: full signal (trigger bar included) within `withinBars`
# mode = Armed:  setup context in place (score + context votes + RSI +
#                trend), awaiting only the trigger bar — the useful mode
#                for building a watchlist
# =============================================================

input mode                = {default Armed, Signal};
input direction           = {default Either, Bull, Bear};
input withinBars          = 3;      # Signal mode: fired within last N bars
input confluenceThreshold = 6.0;    # reduced: weekly grid unavailable in scans
input toleranceATR        = 0.15;
input toleranceRangePct   = 0.02;
input avwapBandATR        = 0.25;
input minContextGates     = 2;
input timeToleranceBars   = 2;
input minSwingATR         = 1.5;
input lookback1H          = 24;     # chart bars (run scan at 1h)
input lookback4H          = 120;    # ~30 4-hour bars, in 1h RTH bars
input lookbackD           = 140;    # ~20 days, in 1h RTH bars
input requireVolume       = yes;
input volumeMult          = 1.3;
input requireHTFTrend     = yes;
input trendLen            = 150;    # ~21 days of 1h RTH bars (daily EMA proxy)
input requireRSI          = yes;
input rsiLength           = 14;
input rsiOversold         = 40;
input rsiOverbought       = 60;

def bn = BarNumber();
def atr = Average(TrueRange(high, close, low), 14);
def tolFloor = atr * toleranceATR;
def volAvg = Average(volume, 20);

# ---------- Swing detection ----------
script getSwingHigh {
    input price = high;
    input left = 5;
    input right = 5;
    input minSize = 0.0;
    def isSwing = price[left] == Highest(price, left + right + 1) and
                  (price[left] - Lowest(price, left + right + 1)) >= minSize;
    plot out = if isSwing then price[left] else Double.NaN;
}

script getSwingLow {
    input price = low;
    input left = 5;
    input right = 5;
    input minSize = 0.0;
    def isSwing = price[left] == Lowest(price, left + right + 1) and
                  (Highest(price, left + right + 1) - price[left]) >= minSize;
    plot out = if isSwing then price[left] else Double.NaN;
}

def minSizeMain = atr * minSwingATR;
def shMain = getSwingHigh(high, 5, 5, minSizeMain);
def slMain = getSwingLow(low, 5, 5, minSizeMain);

def swingDir = if !IsNaN(shMain) and IsNaN(slMain) then 1
               else if !IsNaN(slMain) and IsNaN(shMain) then -1
               else swingDir[1];
def lastSwingHigh    = if !IsNaN(shMain) and (swingDir[1] != 1 or shMain >= lastSwingHigh[1]) then shMain else lastSwingHigh[1];
def lastSwingHighBar = if !IsNaN(shMain) and (swingDir[1] != 1 or shMain >= lastSwingHigh[1]) then bn - 5 else lastSwingHighBar[1];
def lastSwingLow     = if !IsNaN(slMain) and (swingDir[1] != -1 or slMain <= lastSwingLow[1]) then slMain else lastSwingLow[1];
def lastSwingLowBar  = if !IsNaN(slMain) and (swingDir[1] != -1 or slMain <= lastSwingLow[1]) then bn - 5 else lastSwingLowBar[1];

def lastSwingBar = Max(lastSwingHighBar, lastSwingLowBar);
def prevSwingBar = Min(lastSwingHighBar, lastSwingLowBar);
def isUpSwing    = lastSwingHighBar > lastSwingLowBar;

# ---------- Timeframe ranges (chart-bar approximations) ----------
def sh1H = Highest(high, lookback1H);
def sl1H = Lowest(low, lookback1H);
def sh4H = Highest(high, lookback4H);
def sl4H = Lowest(low, lookback4H);
def shD  = Highest(high, lookbackD);
def slD  = Lowest(low, lookbackD);

# ---------- Weighted Fib Score ----------
script fibScore {
    input hi = 0.0;
    input lo = 0.0;
    input price = close;
    input tol = 0.0;

    def range = hi - lo;
    def f35   = lo + 0.350 * range;
    def f382  = lo + 0.382 * range;
    def f50   = lo + 0.500 * range;
    def f618  = lo + 0.618 * range;
    def f65   = lo + 0.650 * range;
    def f127u = hi + 0.272 * range;
    def f161u = hi + 0.618 * range;
    def f127d = lo - 0.272 * range;
    def f161d = lo - 0.618 * range;

    def inGoldenPocket = price >= f618 and price <= f65;
    def inBearPocket   = price >= f35 and price <= f382;

    def s =
        (if AbsValue(price - f618) <= tol or inGoldenPocket then 3.5 else 0.0) +
        (if AbsValue(price - f382) <= tol or inBearPocket then 3.5 else 0.0) +
        (if AbsValue(price - f50)  <= tol then 2.5 else 0.0) +
        (if AbsValue(price - f127u) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f161u) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f127d) <= tol then 1.5 else 0.0) +
        (if AbsValue(price - f161d) <= tol then 1.5 else 0.0);
    plot out = if IsNaN(range) or IsNaN(tol) then 0.0 else s;
}

def tolMain = Max(tolFloor, (lastSwingHigh - lastSwingLow) * toleranceRangePct);
def tol1H   = Max(tolFloor, (sh1H - sl1H) * toleranceRangePct);
def tol4H   = Max(tolFloor, (sh4H - sl4H) * toleranceRangePct);
def tolD    = Max(tolFloor, (shD - slD)   * toleranceRangePct);

def priceConfluenceScore =
    fibScore(lastSwingHigh, lastSwingLow, close, tolMain) +
    fibScore(sh1H, sl1H, close, tol1H) +
    fibScore(sh4H, sl4H, close, tol4H) +
    fibScore(shD,  slD,  close, tolD);
def isPriceConfluence = priceConfluenceScore >= confluenceThreshold;

# ---------- Fib time windows ----------
def span = Max(lastSwingBar - prevSwingBar, 1);
def t382 = lastSwingBar + Round(span * 0.382);
def t500 = lastSwingBar + Round(span * 0.500);
def t618 = lastSwingBar + Round(span * 0.618);
def t100 = lastSwingBar + span;
def t161 = lastSwingBar + Round(span * 1.618);

def timeTol = Max(timeToleranceBars, Round(span * 0.05, 0));
def isTimeWindow =
    span >= 8 and
    (AbsValue(bn - t382) <= timeTol or
     AbsValue(bn - t500) <= timeTol or
     AbsValue(bn - t618) <= timeTol or
     AbsValue(bn - t100) <= timeTol or
     AbsValue(bn - t161) <= timeTol);

# ---------- Anchored VWAP ----------
def newAnchor = lastSwingBar != lastSwingBar[1];
def cumPV = if newAnchor then Sum(close * volume, 6) else cumPV[1] + close * volume;
def cumV  = if newAnchor then Sum(volume, 6) else cumV[1] + volume;
def avwap = if cumV != 0 then cumPV / cumV else Double.NaN;
def nearAVWAP = AbsValue(close - avwap) <= atr * avwapBandATR;

# ---------- Fib fan ----------
def fanRange = lastSwingHigh - lastSwingLow;
def fanSlope = fanRange / span;

def fan382 = if isUpSwing then lastSwingLow + fanSlope * 0.382 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.382 * (bn - lastSwingHighBar);
def fan50  = if isUpSwing then lastSwingLow + fanSlope * 0.500 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.500 * (bn - lastSwingHighBar);
def fan618 = if isUpSwing then lastSwingLow + fanSlope * 0.618 * (bn - lastSwingLowBar)
                          else lastSwingHigh - fanSlope * 0.618 * (bn - lastSwingHighBar);

def nearFan = AbsValue(close - fan382) <= tolMain or
              AbsValue(close - fan50)  <= tolMain or
              AbsValue(close - fan618) <= tolMain;

# ---------- Trend proxy (no secondary aggregation in scans) ----------
def htfEMA = ExpAverage(close, trendLen);
def htfTrendUp   = close > htfEMA;
def htfTrendDown = close < htfEMA;

# ---------- Trigger bar: price action + volume ----------
def bullPA = low < low[1] and close > open and close > close[1] and
             (close - low) > 0.60 * (high - low);
def bearPA = high > high[1] and close < open and close < close[1] and
             (high - close) > 0.60 * (high - low);

def volOK = !requireVolume or volume > volAvg * volumeMult;

# ---------- RSI extreme + swing-to-swing divergence ----------
def rsi = RSI(length = rsiLength);

def rsiExtremeBull = rsi <= rsiOversold;
def rsiExtremeBear = rsi >= rsiOverbought;

def swingLowPrice     = if !IsNaN(slMain) then slMain else swingLowPrice[1];
def swingLowRsi       = if !IsNaN(slMain) then rsi[5] else swingLowRsi[1];
def prevSwingLowPrice = if !IsNaN(slMain) then swingLowPrice[1] else prevSwingLowPrice[1];
def prevSwingLowRsi   = if !IsNaN(slMain) then swingLowRsi[1] else prevSwingLowRsi[1];
def bullDiv = prevSwingLowPrice != 0 and swingLowPrice < prevSwingLowPrice and swingLowRsi > prevSwingLowRsi;

def swingHighPrice     = if !IsNaN(shMain) then shMain else swingHighPrice[1];
def swingHighRsi       = if !IsNaN(shMain) then rsi[5] else swingHighRsi[1];
def prevSwingHighPrice = if !IsNaN(shMain) then swingHighPrice[1] else prevSwingHighPrice[1];
def prevSwingHighRsi   = if !IsNaN(shMain) then swingHighRsi[1] else prevSwingHighRsi[1];
def bearDiv = prevSwingHighPrice != 0 and swingHighPrice > prevSwingHighPrice and swingHighRsi < prevSwingHighRsi;

def rsiBullOK = !requireRSI or rsiExtremeBull or bullDiv;
def rsiBearOK = !requireRSI or rsiExtremeBear or bearDiv;

# ---------- Assembly ----------
def contextCount = (if isTimeWindow then 1 else 0) + (if nearAVWAP then 1 else 0) + (if nearFan then 1 else 0);
def contextOK = contextCount >= minContextGates;

def bullArmed = isPriceConfluence and contextOK and rsiBullOK and (!requireHTFTrend or htfTrendUp);
def bearArmed = isPriceConfluence and contextOK and rsiBearOK and (!requireHTFTrend or htfTrendDown);

def bullFull = bullArmed and bullPA and volOK;
def bearFull = bearArmed and bearPA and volOK;

def bullPick = if mode == mode.Armed then bullArmed else Sum(bullFull, withinBars) > 0;
def bearPick = if mode == mode.Armed then bearArmed else Sum(bearFull, withinBars) > 0;

def dirBull = direction == direction.Bull or direction == direction.Either;
def dirBear = direction == direction.Bear or direction == direction.Either;

plot scan = (dirBull and bullPick) or (dirBear and bearPick);
