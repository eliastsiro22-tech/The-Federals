//@version=6
// =============================================================
// Force of Nature (IndicatorFON) — Pine v6 port of ForceOfNature.tos
// -------------------------------------------------------------
// Highest-probability Fib ratios only + Golden Pocket emphasis
// + Fib Time/Cycles + Anchored VWAP + Fan proximity
// + HTF Trend + Quality PA + Volume + RSI Extreme/Divergence
// Rare, high-confidence signals only
//
// Design notes (kept in lockstep with the thinkScript version):
//  - Each timeframe's fib grid is anchored to that timeframe's recent
//    trading range (last N bars of the TF), not whole-chart extremes —
//    grids are timeframe-distinct, independent of loaded history, and do
//    not repaint when a new chart-wide extreme prints later.
//  - lookahead_on mirrors thinkScript secondary-aggregation semantics:
//    historical chart bars carry the HTF bar's final value, the live bar
//    the developing value. Values only change within the current HTF bar.
//  - Grids below the chart timeframe are disabled — thinkorswim refuses to
//    load the study there at all; the dashboard shows the active count.
//  - thinkScript Round() defaults to 2-digit precision — replicated in the
//    Fib time windows.
// =============================================================

indicator("Force of Nature (IndicatorFON)", "FON", overlay = true)

// ---------- Inputs ----------
showSignals         = input.bool(true,  "Show signals")
confluenceThreshold = input.float(7.5,  "Confluence score threshold", minval = 0, step = 0.5)
toleranceATR        = input.float(0.15, "Level tolerance floor (ATR multiple)", minval = 0, step = 0.01)
toleranceRangePct   = input.float(0.02, "Level tolerance (fraction of grid range)", minval = 0, step = 0.005)
avwapBandATR        = input.float(0.25, "AVWAP band (ATR multiple)", minval = 0, step = 0.01)
minContextGates     = input.int(2,      "Context gates required (time/AVWAP/fan)", minval = 0, maxval = 3)
cooldownBars        = input.int(10,     "Signal cooldown (bars)", minval = 0)
timeToleranceBars   = input.int(2,      "Time window tolerance (bars)", minval = 0)
minSwingATR         = input.float(1.5,  "Min chart swing size (ATR multiple)", minval = 0, step = 0.1)
lookback1H          = input.int(24,     "1H grid lookback (hourly bars)", minval = 2)
lookback4H          = input.int(30,     "4H grid lookback (4-hour bars)", minval = 2)
lookbackD           = input.int(20,     "Daily grid lookback (days)", minval = 2)
lookbackW           = input.int(13,     "Weekly grid lookback (weeks)", minval = 2)
requireVolume       = input.bool(true,  "Require volume surge")
volumeMult          = input.float(1.3,  "Volume multiple", minval = 0, step = 0.1)
requireHTFTrend     = input.bool(true,  "Require HTF trend alignment")
htfTF               = input.timeframe("D", "HTF trend timeframe")
requireRSI          = input.bool(true,  "Require RSI condition")
rsiLength           = input.int(14,     "RSI length", minval = 1)
rsiOversold         = input.float(40,   "RSI oversold", minval = 0, maxval = 100)
rsiOverbought       = input.float(60,   "RSI overbought", minval = 0, maxval = 100)
showDashboard       = input.bool(true,  "Show dashboard")
dashPosTxt          = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"])
showAVWAP           = input.bool(true,  "Show anchored VWAP")

// thinkScript Average(TrueRange(...)) is a simple MA of true range
atr      = ta.sma(ta.tr(true), 14)
tolFloor = atr * toleranceATR
volAvg   = ta.sma(volume, 20)

// ---------- Helpers ----------
// Exact replica of thinkScript getSwingHigh/getSwingLow: the == Highest
// comparison allows ties at flat tops/bottoms (ta.pivothigh does not).
// ta calls are hoisted to unconditional locals (CW10002).
stepSwingHigh(float src, simple int l, simple int r, float minSize) =>
    float hi = ta.highest(src, l + r + 1)
    float lo = ta.lowest(src, l + r + 1)
    src[l] == hi and (src[l] - lo) >= minSize ? src[l] : na

stepSwingLow(float src, simple int l, simple int r, float minSize) =>
    float hi = ta.highest(src, l + r + 1)
    float lo = ta.lowest(src, l + r + 1)
    src[l] == lo and (hi - src[l]) >= minSize ? src[l] : na

// thinkScript Round() defaults to 2-digit precision
round2(float x) =>
    math.round(x * 100) / 100

inTimeWindow(float t, float tolBars) =>
    not na(t) and not na(tolBars) and math.abs(bar_index - t) <= tolBars

// ---------- Weighted Fib Score (Golden Pocket emphasis) ----------
fibScore(float hi, float lo, float price, float tolerance) =>
    float s = 0.0
    if not na(hi) and not na(lo)
        rng   = hi - lo
        f35   = lo + 0.350 * rng
        f382  = lo + 0.382 * rng
        f50   = lo + 0.500 * rng
        f618  = lo + 0.618 * rng
        f65   = lo + 0.650 * rng
        f127u = hi + 0.272 * rng
        f161u = hi + 0.618 * rng
        f127d = lo - 0.272 * rng
        f161d = lo - 0.618 * rng
        // golden pocket (0.618-0.65 up from the low) and its bearish mirror
        // (0.35-0.382, the same pocket measured down from the high) score
        // equally, so short setups are not structurally under-weighted;
        // extensions exist on both sides of the range
        inGoldenPocket = price >= f618 and price <= f65
        inBearPocket   = price >= f35 and price <= f382
        s += (math.abs(price - f618) <= tolerance or inGoldenPocket) ? 3.5 : 0.0
        s += (math.abs(price - f382) <= tolerance or inBearPocket) ? 3.5 : 0.0
        s += math.abs(price - f50)   <= tolerance ? 2.5 : 0.0
        s += math.abs(price - f127u) <= tolerance ? 1.5 : 0.0
        s += math.abs(price - f161u) <= tolerance ? 1.5 : 0.0
        s += math.abs(price - f127d) <= tolerance ? 1.5 : 0.0
        s += math.abs(price - f161d) <= tolerance ? 1.5 : 0.0
    s

// ---------- Significant Swing Detection (chart timeframe) ----------
minSizeMain = atr * minSwingATR
shMain = stepSwingHigh(high, 5, 5, minSizeMain)
slMain = stepSwingLow(low, 5, 5, minSizeMain)

var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na
var int   swingDir         = 0

// alternate swings so the tracked high/low pair is always one real leg: an
// opposite-side pivot starts a new leg; a same-side pivot only counts if it
// is more extreme than the current leg extreme
acceptHi = not na(shMain) and (swingDir != 1 or shMain >= nz(lastSwingHigh, shMain))
acceptLo = not na(slMain) and (swingDir != -1 or slMain <= nz(lastSwingLow, slMain))

if acceptHi
    lastSwingHigh    := shMain
    lastSwingHighBar := bar_index - 5
if acceptLo
    lastSwingLow    := slMain
    lastSwingLowBar := bar_index - 5
if acceptHi and not acceptLo
    swingDir := 1
else if acceptLo and not acceptHi
    swingDir := -1

swingsReady  = not na(lastSwingHighBar) and not na(lastSwingLowBar)
lastSwingBar = swingsReady ? math.max(lastSwingHighBar, lastSwingLowBar) : na
prevSwingBar = swingsReady ? math.min(lastSwingHighBar, lastSwingLowBar) : na
isUpSwing    = swingsReady and lastSwingHighBar > lastSwingLowBar

// ---------- Key Higher Timeframe Ranges ----------
// each timeframe's fib grid anchors to its recent trading range (last N
// bars of that TF, computed on the TF's own bars). Grids below the chart
// timeframe are disabled (thinkorswim errors there).
chartSec = timeframe.in_seconds(timeframe.period)
d1OK = chartSec <= timeframe.in_seconds("D")
h4OK = chartSec <= timeframe.in_seconds("240")
h1OK = chartSec <= timeframe.in_seconds("60")
wOK  = chartSec <= timeframe.in_seconds("W")

[shD_r, slD_r]   = request.security(syminfo.tickerid, d1OK ? "D" : timeframe.period,   [ta.highest(high, lookbackD),  ta.lowest(low, lookbackD)],  lookahead = barmerge.lookahead_on)
[sh4H_r, sl4H_r] = request.security(syminfo.tickerid, h4OK ? "240" : timeframe.period, [ta.highest(high, lookback4H), ta.lowest(low, lookback4H)], lookahead = barmerge.lookahead_on)
[sh1H_r, sl1H_r] = request.security(syminfo.tickerid, h1OK ? "60" : timeframe.period,  [ta.highest(high, lookback1H), ta.lowest(low, lookback1H)], lookahead = barmerge.lookahead_on)
[shW_r, slW_r]   = request.security(syminfo.tickerid, wOK ? "W" : timeframe.period,    [ta.highest(high, lookbackW),  ta.lowest(low, lookbackW)],  lookahead = barmerge.lookahead_on)

shD  = d1OK ? shD_r : na
slD  = d1OK ? slD_r : na
sh4H = h4OK ? sh4H_r : na
sl4H = h4OK ? sl4H_r : na
sh1H = h1OK ? sh1H_r : na
sl1H = h1OK ? sl1H_r : na
shW  = wOK ? shW_r : na
slW  = wOK ? slW_r : na

// ---------- Scores ----------
// per-grid tolerance: ATR floor, widened proportionally for bigger ranges —
// a weekly level deserves a wider band than a 1-hour level
gridTol(float hi, float lo) =>
    math.max(tolFloor, (hi - lo) * toleranceRangePct)

tolMain = gridTol(lastSwingHigh, lastSwingLow)
tolD    = gridTol(shD, slD)
tol4H   = gridTol(sh4H, sl4H)
tol1H   = gridTol(sh1H, sl1H)
tolW    = gridTol(shW, slW)

scoreD    = fibScore(shD,  slD,  close, tolD)
score4H   = fibScore(sh4H, sl4H, close, tol4H)
score1H   = fibScore(sh1H, sl1H, close, tol1H)
scoreW    = fibScore(shW,  slW,  close, tolW)
scoreMain = fibScore(lastSwingHigh, lastSwingLow, close, tolMain)

priceConfluenceScore = scoreD + score4H + score1H + scoreW + scoreMain
isPriceConfluence    = priceConfluenceScore >= confluenceThreshold

// ---------- Fib Time + Cycle Windows ----------
span = swingsReady ? math.max(lastSwingBar - prevSwingBar, 1) : na

t382 = swingsReady ? lastSwingBar + round2(span * 0.382) : na
t500 = swingsReady ? lastSwingBar + round2(span * 0.500) : na
t618 = swingsReady ? lastSwingBar + round2(span * 0.618) : na
t100 = swingsReady ? lastSwingBar + span : na
t161 = swingsReady ? lastSwingBar + round2(span * 1.618) : na

// windows only mean something on a real leg (span >= 8) and their tolerance
// scales with the leg duration instead of a fixed bar count
timeTol = swingsReady ? math.max(timeToleranceBars, math.round(span * 0.05)) : na

isTimeWindow = nz(span) >= 8 and (inTimeWindow(t382, timeTol) or inTimeWindow(t500, timeTol) or
  inTimeWindow(t618, timeTol) or inTimeWindow(t100, timeTol) or inTimeWindow(t161, timeTol))

// ---------- Anchored VWAP ----------
// Cumulative-reset replication of Sum(x, barsSince): a new anchor always
// confirms exactly 5 bars after its pivot, so the window re-seeds with the
// last 6 bars. Seeds are computed unconditionally (CW10003).
seedPV = math.sum(close * volume, 6)
seedV  = math.sum(volume, 6)

var float cumPV     = na
var float cumV      = na
var int   anchorBar = na

if swingsReady and (na(anchorBar) or lastSwingBar != anchorBar)
    anchorBar := lastSwingBar
    cumPV := seedPV
    cumV  := seedV
else if not na(anchorBar)
    cumPV += close * volume
    cumV  += volume

avwap     = not na(cumV) and cumV != 0 ? cumPV / cumV : na
nearAVWAP = not na(avwap) and math.abs(close - avwap) <= atr * avwapBandATR

// ---------- Fibonacci Fan Proximity ----------
fanRange = lastSwingHigh - lastSwingLow
fanSlope = swingsReady ? fanRange / span : na

fanLevel(float ratio) =>
    float lvl = na
    if swingsReady
        lvl := isUpSwing ? lastSwingLow + fanSlope * ratio * (bar_index - lastSwingLowBar) : lastSwingHigh - fanSlope * ratio * (bar_index - lastSwingHighBar)
    lvl

fan382 = fanLevel(0.382)
fan50  = fanLevel(0.500)
fan618 = fanLevel(0.618)

nearFan = not na(fan382) and not na(tolMain) and (math.abs(close - fan382) <= tolMain or
  math.abs(close - fan50) <= tolMain or math.abs(close - fan618) <= tolMain)

// ---------- HTF Trend Filter ----------
// true 21-period EMA of the higher timeframe, computed on its own bars
[htfClose, htfEMA] = request.security(syminfo.tickerid, timeframe.in_seconds(htfTF) >= chartSec ? htfTF : timeframe.period, [close, ta.ema(close, 21)], lookahead = barmerge.lookahead_on)
htfTrendUp   = not na(htfEMA) and htfClose > htfEMA
htfTrendDown = not na(htfEMA) and htfClose < htfEMA

// ---------- Quality Price Action + Volume ----------
bullPA = low < low[1] and close > open and close > close[1] and
  (close - low) > 0.60 * (high - low)
bearPA = high > high[1] and close < open and close < close[1] and
  (high - close) > 0.60 * (high - low)

volOK = not requireVolume or volume > volAvg * volumeMult

// ---------- RSI Extreme + Simple Regular Divergence ----------
rsi = ta.rsi(close, rsiLength)

rsiExtremeBull = rsi <= rsiOversold
rsiExtremeBear = rsi >= rsiOverbought

// regular divergence measured swing-to-swing: price sets a lower low while
// RSI at those two swing lows sets a higher low (mirrored for bearish) —
// the original compared price lows against same-bar 6-bar RSI highs, a
// near-contradiction that could never fire
var float swingLowPrice     = na
var float swingLowRsi       = na
var float prevSwingLowPrice = na
var float prevSwingLowRsi   = na
if not na(slMain)
    prevSwingLowPrice := swingLowPrice
    prevSwingLowRsi   := swingLowRsi
    swingLowPrice     := slMain
    swingLowRsi       := rsi[5]

var float swingHighPrice     = na
var float swingHighRsi       = na
var float prevSwingHighPrice = na
var float prevSwingHighRsi   = na
if not na(shMain)
    prevSwingHighPrice := swingHighPrice
    prevSwingHighRsi   := swingHighRsi
    swingHighPrice     := shMain
    swingHighRsi       := rsi[5]

bullDiv = not na(prevSwingLowPrice) and swingLowPrice < prevSwingLowPrice and swingLowRsi > prevSwingLowRsi
bearDiv = not na(prevSwingHighPrice) and swingHighPrice > prevSwingHighPrice and swingHighRsi < prevSwingHighRsi

rsiBullOK = not requireRSI or rsiExtremeBull or bullDiv
rsiBearOK = not requireRSI or rsiExtremeBear or bearDiv

// ---------- FULL HIGH-CONVICTION CONFLUENCE ----------
// time window, AVWAP and fan act as context votes: require K of 3 instead
// of all three tight bands at once (the old triple-AND multiplied three
// narrow proximity requirements and made live signals practically impossible)
contextCount = (isTimeWindow ? 1 : 0) + (nearAVWAP ? 1 : 0) + (nearFan ? 1 : 0)
contextOK = contextCount >= minContextGates

bullGates = contextOK and bullPA and volOK and
  rsiBullOK and (not requireHTFTrend or htfTrendUp)
bearGates = contextOK and bearPA and volOK and
  rsiBearOK and (not requireHTFTrend or htfTrendDown)

bullConfluence = bullGates and isPriceConfluence
bearConfluence = bearGates and isPriceConfluence

// suppress signal clusters: once a signal fires, stand down for N bars
var int lastSigBar = -1000000
canFire = bar_index - lastSigBar > cooldownBars
bullSig = bullConfluence and canFire
bearSig = bearConfluence and canFire
if bullSig or bearSig
    lastSigBar := bar_index

// "armed": full setup context in place, awaiting only the trigger bar
// (price action + volume). Exposed as plots for the Pine Screener.
armedBull = isPriceConfluence and contextOK and rsiBullOK and (not requireHTFTrend or htfTrendUp)
armedBear = isPriceConfluence and contextOK and rsiBearOK and (not requireHTFTrend or htfTrendDown)

// ---------- Diagnostics (status line + data window, nothing on the pane) ----------
// hover any bar with the Data Window open to see which gates pass (1) or fail (0)
plot(priceConfluenceScore, "Score", color.gray, display = display.status_line + display.data_window)
plot(bullSig ? 1 : 0, "Bull now", color.aqua, display = display.status_line + display.data_window)
plot(bearSig ? 1 : 0, "Bear now", color.fuchsia, display = display.status_line + display.data_window)
plot(isTimeWindow ? 1 : 0, "Gate: time window", display = display.data_window)
plot(nearAVWAP ? 1 : 0, "Gate: AVWAP", display = display.data_window)
plot(nearFan ? 1 : 0, "Gate: fan", display = display.data_window)
plot(bullPA ? 1 : 0, "Gate: bull PA", display = display.data_window)
plot(bearPA ? 1 : 0, "Gate: bear PA", display = display.data_window)
plot(volOK ? 1 : 0, "Gate: volume", display = display.data_window)
plot(rsiBullOK ? 1 : 0, "Gate: RSI bull", display = display.data_window)
plot(rsiBearOK ? 1 : 0, "Gate: RSI bear", display = display.data_window)
plot(htfTrendUp ? 1 : 0, "Gate: HTF trend up", display = display.data_window)
plot(contextCount, "Context gates (0-3)", display = display.data_window)
plot(armedBull ? 1 : 0, "Armed bull", display = display.data_window)
plot(armedBear ? 1 : 0, "Armed bear", display = display.data_window)
plot(scoreMain, "Score: chart grid", display = display.data_window)
plot(scoreD, "Score: daily grid", display = display.data_window)
plot(score4H, "Score: 4H grid", display = display.data_window)
plot(score1H, "Score: 1H grid", display = display.data_window)
plot(scoreW, "Score: weekly grid", display = display.data_window)

// ---------- Signals ----------
// (display.pane — the status line already shows "Bull now"/"Bear now")
plotshape(showSignals and bullSig, "Bull signal", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.normal, display = display.pane)
plotshape(showSignals and bearSig, "Bear signal", shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size = size.normal, display = display.pane)

alertcondition(bullSig, "FON Bull", "Force of Nature: bullish confluence on {{ticker}} {{interval}}")
alertcondition(bearSig, "FON Bear", "Force of Nature: bearish confluence on {{ticker}} {{interval}}")
// combined conditions: one alert slot per symbol instead of two
alertcondition(bullSig or bearSig, "FON Any signal", "Force of Nature: signal on {{ticker}} {{interval}}")
alertcondition((armedBull and not armedBull[1]) or (armedBear and not armedBear[1]), "FON Armed", "Force of Nature: {{ticker}} {{interval}} armed — watch for trigger bar")

// ---------- Anchored VWAP Line ----------
plot(showAVWAP ? avwap : na, "AVWAP", color.new(color.yellow, 0), 2, plot.style_linebr)

// ---------- Dashboard ----------
activeGrids = 1 + (d1OK ? 1 : 0) + (h4OK ? 1 : 0) + (h1OK ? 1 : 0) + (wOK ? 1 : 0)

// default Top right: on TradingView the top-left corner sits under the
// indicator legend, unlike thinkorswim's AddLabel
dashPos = dashPosTxt == "Top right" ? position.top_right : dashPosTxt == "Top left" ? position.top_left : dashPosTxt == "Bottom right" ? position.bottom_right : position.bottom_left

var table dash = showDashboard ? table.new(dashPos, 7, 1) : na

if showDashboard and barstate.islast
    sigActive = bullConfluence or bearConfluence
    bg  = sigActive ? color.new(color.green, 55) : color.new(color.gray, 70)
    txt = color.white
    rsiMark = sigActive ? "✓" : rsiBullOK or rsiBearOK ? "·" : "×"
    htfMark = htfTrendUp ? "▲" : htfTrendDown ? "▼" : "─"
    table.cell(dash, 0, 0, "Score: " + str.tostring(priceConfluenceScore, "0.0"), bgcolor = bg, text_color = txt)
    table.cell(dash, 1, 0, "Time: "  + (isTimeWindow ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 2, 0, "AVWAP: " + (nearAVWAP ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 3, 0, "Fan: "   + (nearFan ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 4, 0, "RSI: "   + rsiMark, bgcolor = bg, text_color = txt)
    table.cell(dash, 5, 0, "HTF: "   + htfMark, bgcolor = bg, text_color = txt)
    table.cell(dash, 6, 0, "Grids: " + str.tostring(activeGrids) + "/5", bgcolor = bg, text_color = txt)
