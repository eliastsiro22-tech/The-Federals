//@version=6
// =============================================================
// Force of Nature (IndicatorFON) — Pine v6 port of ForceOfNature.tos
// -------------------------------------------------------------
// Highest-probability Fib ratios only + Golden Pocket emphasis
// + Fib Time/Cycles + Anchored VWAP + Fan proximity
// + HTF Trend + Quality PA + Volume + RSI Extreme/Divergence
// Rare, high-confidence signals only
//
// Parity notes (see docs/pine-conversion.md):
//  - HTF data uses lookahead_on to mirror thinkScript high(period=...)
//    semantics: historical chart bars carry the HTF period's FINAL value,
//    the live bar carries the developing value — same as thinkorswim.
//  - HTF pivots run on CHART bars over those step series, sized by the
//    CHART's ATR, exactly as the original getSwingHigh/getSwingLow calls do.
//  - HighestAll/LowestAll (whole-chart scans) are emulated: running
//    extremes equal thinkorswim's values at the last bar, and repaint-parity
//    mode recomputes historical signals against those final extremes.
//  - "Match thinkorswim history" off = causal mode: arrows use only
//    information available at each bar (honest backtesting; history differs).
//  - Grids below the chart timeframe are disabled — thinkorswim refuses to
//    load the study there at all ("secondary period less than primary");
//    the dashboard shows the active grid count.
//  - thinkScript Round() defaults to 2-digit precision — replicated in the
//    Fib time windows.
// =============================================================

indicator("Force of Nature (IndicatorFON)", "FON", overlay = true, max_labels_count = 500)

// ---------- Inputs ----------
showSignals         = input.bool(true,  "Show signals")
repaintParity       = input.bool(true,  "Match thinkorswim history (repaint)")
confluenceThreshold = input.float(7.5,  "Confluence score threshold", minval = 0, step = 0.5)
tolerancePct        = input.float(0.10, "Level tolerance (ATR multiple)", minval = 0, step = 0.01)
timeToleranceBars   = input.int(2,      "Time window tolerance (bars)", minval = 0)
minSwingATR         = input.float(1.5,  "Min chart swing size (ATR multiple)", minval = 0, step = 0.1)
requireVolume       = input.bool(true,  "Require volume surge")
volumeMult          = input.float(1.3,  "Volume multiple", minval = 0, step = 0.1)
requireHTFTrend     = input.bool(true,  "Require HTF trend alignment")
htfTF               = input.timeframe("D", "HTF trend timeframe")
requireRSI          = input.bool(true,  "Require RSI condition")
rsiLength           = input.int(14,     "RSI length", minval = 1)
rsiOversold         = input.float(40,   "RSI oversold", minval = 0, maxval = 100)
rsiOverbought       = input.float(60,   "RSI overbought", minval = 0, maxval = 100)
showDashboard       = input.bool(true,  "Show dashboard")
dashPosTxt          = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"])
showAVWAP           = input.bool(true,  "Show anchored VWAP")

// thinkScript Average(TrueRange(...)) is a simple MA of true range
atr    = ta.sma(ta.tr(true), 14)
tol    = atr * tolerancePct
volAvg = ta.sma(volume, 20)

// ---------- Helpers ----------
// Exact replica of thinkScript getSwingHigh/getSwingLow: the == Highest
// comparison allows ties at flat tops/bottoms (ta.pivothigh does not).
// ta calls are hoisted to unconditional locals (CW10002).
stepSwingHigh(float src, simple int l, simple int r, float minSize) =>
    float hi = ta.highest(src, l + r + 1)
    float lo = ta.lowest(src, l + r + 1)
    src[l] == hi and (src[l] - lo) >= minSize ? src[l] : na

stepSwingLow(float src, simple int l, simple int r, float minSize) =>
    float hi = ta.highest(src, l + r + 1)
    float lo = ta.lowest(src, l + r + 1)
    src[l] == lo and (hi - src[l]) >= minSize ? src[l] : na

// running extremes; at the last bar these equal HighestAll/LowestAll over
// the loaded chart, which is all thinkorswim ever sees either
runMax(float v) =>
    var float m = na
    m := na(v) ? m : math.max(nz(m, v), v)
    m

runMin(float v) =>
    var float m = na
    m := na(v) ? m : math.min(nz(m, v), v)
    m

// thinkScript Round() defaults to 2-digit precision
round2(float x) =>
    math.round(x * 100) / 100

// na-safe change detector
chg(float x) =>
    nz(x, -1.0e308) != nz(x[1], -1.0e308)

inTimeWindow(float t) =>
    not na(t) and math.abs(bar_index - t) <= timeToleranceBars

// ---------- Weighted Fib Score (Golden Pocket emphasis) ----------
fibScore(float hi, float lo, float price, float tolerance) =>
    float s = 0.0
    if not na(hi) and not na(lo)
        rng  = hi - lo
        f382 = lo + 0.382 * rng
        f50  = lo + 0.500 * rng
        f618 = lo + 0.618 * rng
        f65  = lo + 0.650 * rng
        f127 = hi + 0.272 * rng
        f161 = hi + 0.618 * rng
        inGoldenPocket = price >= f618 and price <= f65
        s += (math.abs(price - f618) <= tolerance or inGoldenPocket) ? 3.5 : 0.0
        s += math.abs(price - f50)  <= tolerance ? 2.5 : 0.0
        s += math.abs(price - f382) <= tolerance ? 2.0 : 0.0
        s += math.abs(price - f127) <= tolerance ? 1.5 : 0.0
        s += math.abs(price - f161) <= tolerance ? 1.5 : 0.0
    s

// ---------- Significant Swing Detection (chart timeframe) ----------
minSizeMain = atr * minSwingATR
shMain = stepSwingHigh(high, 5, 5, minSizeMain)
slMain = stepSwingLow(low, 5, 5, minSizeMain)

var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if not na(shMain)
    lastSwingHigh    := shMain
    lastSwingHighBar := bar_index - 5
if not na(slMain)
    lastSwingLow    := slMain
    lastSwingLowBar := bar_index - 5

swingsReady  = not na(lastSwingHighBar) and not na(lastSwingLowBar)
lastSwingBar = swingsReady ? math.max(lastSwingHighBar, lastSwingLowBar) : na
prevSwingBar = swingsReady ? math.min(lastSwingHighBar, lastSwingLowBar) : na
isUpSwing    = swingsReady and lastSwingHighBar > lastSwingLowBar

// ---------- Key Higher Timeframe Swings ----------
// lookahead_on mirrors thinkScript high(period=...): historical bars carry
// the period's final value; the live bar carries the developing value.
// Grids below the chart timeframe are disabled (thinkorswim errors there).
chartSec = timeframe.in_seconds(timeframe.period)
d1OK = chartSec <= timeframe.in_seconds("D")
h4OK = chartSec <= timeframe.in_seconds("240")
h1OK = chartSec <= timeframe.in_seconds("60")
wOK  = chartSec <= timeframe.in_seconds("W")

hD  = request.security(syminfo.tickerid, d1OK ? "D" : timeframe.period,   high, lookahead = barmerge.lookahead_on)
lD  = request.security(syminfo.tickerid, d1OK ? "D" : timeframe.period,   low,  lookahead = barmerge.lookahead_on)
h4H = request.security(syminfo.tickerid, h4OK ? "240" : timeframe.period, high, lookahead = barmerge.lookahead_on)
l4H = request.security(syminfo.tickerid, h4OK ? "240" : timeframe.period, low,  lookahead = barmerge.lookahead_on)
h1H = request.security(syminfo.tickerid, h1OK ? "60" : timeframe.period,  high, lookahead = barmerge.lookahead_on)
l1H = request.security(syminfo.tickerid, h1OK ? "60" : timeframe.period,  low,  lookahead = barmerge.lookahead_on)
hW  = request.security(syminfo.tickerid, wOK ? "W" : timeframe.period,    high, lookahead = barmerge.lookahead_on)
lW  = request.security(syminfo.tickerid, wOK ? "W" : timeframe.period,    low,  lookahead = barmerge.lookahead_on)

// pivots on CHART bars over the step series, sized by the CHART's ATR —
// exactly as the original applies getSwingHigh/getSwingLow to hD/h4H/...
shD_raw  = stepSwingHigh(hD,  3, 3, atr * 2.0)
slD_raw  = stepSwingLow(lD,   3, 3, atr * 2.0)
sh4H_raw = stepSwingHigh(h4H, 3, 3, atr * 1.5)
sl4H_raw = stepSwingLow(l4H,  3, 3, atr * 1.5)
sh1H_raw = stepSwingHigh(h1H, 3, 3, atr * 1.0)
sl1H_raw = stepSwingLow(l1H,  3, 3, atr * 1.0)
shW_raw  = stepSwingHigh(hW,  2, 2, atr * 3.0)
slW_raw  = stepSwingLow(lW,   2, 2, atr * 3.0)

shD  = runMax(d1OK ? shD_raw : na)
slD  = runMin(d1OK ? slD_raw : na)
sh4H = runMax(h4OK ? sh4H_raw : na)
sl4H = runMin(h4OK ? sl4H_raw : na)
sh1H = runMax(h1OK ? sh1H_raw : na)
sl1H = runMin(h1OK ? sl1H_raw : na)
shW  = runMax(wOK ? shW_raw : na)
slW  = runMin(wOK ? slW_raw : na)

// ---------- Scores ----------
scoreD    = fibScore(shD,  slD,  close, tol)
score4H   = fibScore(sh4H, sl4H, close, tol)
score1H   = fibScore(sh1H, sl1H, close, tol)
scoreW    = fibScore(shW,  slW,  close, tol)
scoreMain = fibScore(lastSwingHigh, lastSwingLow, close, tol)

priceConfluenceScore = scoreD + score4H + score1H + scoreW + scoreMain
isPriceConfluence    = priceConfluenceScore >= confluenceThreshold

// ---------- Fib Time + Cycle Windows ----------
span = swingsReady ? math.max(lastSwingBar - prevSwingBar, 1) : na

t382 = swingsReady ? lastSwingBar + round2(span * 0.382) : na
t500 = swingsReady ? lastSwingBar + round2(span * 0.500) : na
t618 = swingsReady ? lastSwingBar + round2(span * 0.618) : na
t100 = swingsReady ? lastSwingBar + span : na
t161 = swingsReady ? lastSwingBar + round2(span * 1.618) : na

isTimeWindow = inTimeWindow(t382) or inTimeWindow(t500) or inTimeWindow(t618) or
  inTimeWindow(t100) or inTimeWindow(t161)

// ---------- Anchored VWAP ----------
// Cumulative-reset replication of Sum(x, barsSince): a new anchor always
// confirms exactly 5 bars after its pivot, so the window re-seeds with the
// last 6 bars. Seeds are computed unconditionally (CW10003).
seedPV = math.sum(close * volume, 6)
seedV  = math.sum(volume, 6)

var float cumPV     = na
var float cumV      = na
var int   anchorBar = na

if swingsReady and (na(anchorBar) or lastSwingBar != anchorBar)
    anchorBar := lastSwingBar
    cumPV := seedPV
    cumV  := seedV
else if not na(anchorBar)
    cumPV += close * volume
    cumV  += volume

avwap     = not na(cumV) and cumV != 0 ? cumPV / cumV : na
nearAVWAP = not na(avwap) and math.abs(close - avwap) <= atr * 0.12

// ---------- Fibonacci Fan Proximity ----------
fanRange = lastSwingHigh - lastSwingLow
fanSlope = swingsReady ? fanRange / span : na

fanLevel(float ratio) =>
    float lvl = na
    if swingsReady
        lvl := isUpSwing ? lastSwingLow + fanSlope * ratio * (bar_index - lastSwingLowBar) : lastSwingHigh - fanSlope * ratio * (bar_index - lastSwingHighBar)
    lvl

fan382 = fanLevel(0.382)
fan50  = fanLevel(0.500)
fan618 = fanLevel(0.618)

nearFan = not na(fan382) and (math.abs(close - fan382) <= tol or
  math.abs(close - fan50) <= tol or math.abs(close - fan618) <= tol)

// ---------- HTF Trend Filter ----------
// ExpAverage(close(period = htfAgg), 21) in the original is an EMA over
// CHART bars of the HTF close step series — replicated exactly (on intraday
// charts this is NOT a true 21-period EMA of the higher timeframe)
htfClose = request.security(syminfo.tickerid, timeframe.in_seconds(htfTF) >= chartSec ? htfTF : timeframe.period, close, lookahead = barmerge.lookahead_on)
htfEMA   = ta.ema(htfClose, 21)
htfTrendUp   = not na(htfEMA) and htfClose > htfEMA
htfTrendDown = not na(htfEMA) and htfClose < htfEMA

// ---------- Quality Price Action + Volume ----------
bullPA = low < low[1] and close > open and close > close[1] and
  (close - low) > 0.60 * (high - low)
bearPA = high > high[1] and close < open and close < close[1] and
  (high - close) > 0.60 * (high - low)

volOK = not requireVolume or volume > volAvg * volumeMult

// ---------- RSI Extreme + Simple Regular Divergence ----------
rsi = ta.rsi(close, rsiLength)

rsiExtremeBull = rsi <= rsiOversold
rsiExtremeBear = rsi >= rsiOverbought

priceLL = low < ta.lowest(low[1], 6)
rsiHL   = rsi > ta.highest(rsi[1], 6)
bullDiv = priceLL and rsiHL

priceHH = high > ta.highest(high[1], 6)
rsiLH   = rsi < ta.lowest(rsi[1], 6)
bearDiv = priceHH and rsiLH

rsiBullOK = not requireRSI or rsiExtremeBull or bullDiv
rsiBearOK = not requireRSI or rsiExtremeBear or bearDiv

// ---------- FULL HIGH-CONVICTION CONFLUENCE ----------
// everything except the four HTF fib grids is causal in the original too;
// these gate booleans are reused by the parity recomputation below
bullGates = isTimeWindow and nearAVWAP and nearFan and bullPA and volOK and
  rsiBullOK and (not requireHTFTrend or htfTrendUp)
bearGates = isTimeWindow and nearAVWAP and nearFan and bearPA and volOK and
  rsiBearOK and (not requireHTFTrend or htfTrendDown)

bullConfluence = bullGates and isPriceConfluence
bearConfluence = bearGates and isPriceConfluence

// ---------- Diagnostics (status line + data window, nothing on the pane) ----------
// hover any bar with the Data Window open to see which gates pass (1) or fail (0)
plot(priceConfluenceScore, "Score", color.gray, display = display.status_line + display.data_window)
plot(bullConfluence ? 1 : 0, "Bull now", color.aqua, display = display.status_line + display.data_window)
plot(bearConfluence ? 1 : 0, "Bear now", color.fuchsia, display = display.status_line + display.data_window)
plot(isTimeWindow ? 1 : 0, "Gate: time window", display = display.data_window)
plot(nearAVWAP ? 1 : 0, "Gate: AVWAP", display = display.data_window)
plot(nearFan ? 1 : 0, "Gate: fan", display = display.data_window)
plot(bullPA ? 1 : 0, "Gate: bull PA", display = display.data_window)
plot(bearPA ? 1 : 0, "Gate: bear PA", display = display.data_window)
plot(volOK ? 1 : 0, "Gate: volume", display = display.data_window)
plot(rsiBullOK ? 1 : 0, "Gate: RSI bull", display = display.data_window)
plot(rsiBearOK ? 1 : 0, "Gate: RSI bear", display = display.data_window)
plot(htfTrendUp ? 1 : 0, "Gate: HTF trend up", display = display.data_window)
plot(scoreMain, "Score: chart grid", display = display.data_window)
plot(scoreD, "Score: daily grid", display = display.data_window)
plot(score4H, "Score: 4H grid", display = display.data_window)
plot(score1H, "Score: 1H grid", display = display.data_window)
plot(scoreW, "Score: weekly grid", display = display.data_window)

// ---------- Signal history (for thinkorswim-parity repaint mode) ----------
var closeA = array.new_float()
var tolA   = array.new_float()
var lowA   = array.new_float()
var highA  = array.new_float()
var atrA   = array.new_float()
var mainA  = array.new_float()
var bullA  = array.new_bool()
var bearA  = array.new_bool()
var idxA   = array.new_int()

if barstate.isconfirmed
    array.push(closeA, close)
    array.push(tolA, tol)
    array.push(lowA, low)
    array.push(highA, high)
    array.push(atrA, atr)
    array.push(mainA, scoreMain)
    array.push(bullA, bullGates)
    array.push(bearA, bearGates)
    array.push(idxA, bar_index)

// ---------- Signals ----------
// causal mode: arrows use only information available at each bar
// (display.pane keeps these always-0-in-parity-mode series out of the status line)
plotshape(not repaintParity and showSignals and bullConfluence, "Bull signal (causal)", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.small, display = display.pane)
plotshape(not repaintParity and showSignals and bearConfluence, "Bear signal (causal)", shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size = size.small, display = display.pane)

alertcondition(bullConfluence, "FON Bull", "Force of Nature: bullish confluence on {{ticker}} {{interval}}")
alertcondition(bearConfluence, "FON Bear", "Force of Nature: bearish confluence on {{ticker}} {{interval}}")

// parity mode: thinkorswim evaluates the HighestAll grids with the whole
// chart in view, so its historical arrows use the FINAL swing extremes —
// recompute history against the last-bar extremes and draw matching labels
var label[] sigLabels = array.new_label()
var int lastDrawN = -1

if repaintParity and showSignals and barstate.islast
    needRedraw = array.size(idxA) != lastDrawN or chg(shD) or chg(slD) or
      chg(sh4H) or chg(sl4H) or chg(sh1H) or chg(sl1H) or chg(shW) or chg(slW)
    if needRedraw
        lastDrawN := array.size(idxA)
        while array.size(sigLabels) > 0
            label.delete(array.pop(sigLabels))
        if array.size(idxA) > 0
            for i = 0 to array.size(idxA) - 1
                float c  = array.get(closeA, i)
                float tl = array.get(tolA, i)
                float sc = array.get(mainA, i) + fibScore(shD, slD, c, tl) +
                  fibScore(sh4H, sl4H, c, tl) + fibScore(sh1H, sl1H, c, tl) +
                  fibScore(shW, slW, c, tl)
                if sc >= confluenceThreshold
                    if array.get(bullA, i)
                        array.push(sigLabels, label.new(array.get(idxA, i), array.get(lowA, i) - array.get(atrA, i) * 0.45, "", xloc.bar_index, yloc.price, color.new(color.aqua, 0), label.style_triangleup, color.aqua, size.small))
                    if array.get(bearA, i)
                        array.push(sigLabels, label.new(array.get(idxA, i), array.get(highA, i) + array.get(atrA, i) * 0.45, "", xloc.bar_index, yloc.price, color.new(color.fuchsia, 0), label.style_triangledown, color.fuchsia, size.small))
        while array.size(sigLabels) > 480
            label.delete(array.shift(sigLabels))

// live (unconfirmed) bar in parity mode — the causal levels already equal
// the final levels on the last bar, so the causal condition is exact here
var label curLbl = na
if repaintParity and barstate.islast
    if not na(curLbl)
        label.delete(curLbl)
        curLbl := na
    if showSignals and not barstate.isconfirmed
        if bullConfluence
            curLbl := label.new(bar_index, low - atr * 0.45, "", xloc.bar_index, yloc.price, color.new(color.aqua, 0), label.style_triangleup, color.aqua, size.small)
        else if bearConfluence
            curLbl := label.new(bar_index, high + atr * 0.45, "", xloc.bar_index, yloc.price, color.new(color.fuchsia, 0), label.style_triangledown, color.fuchsia, size.small)

// ---------- Anchored VWAP Line ----------
plot(showAVWAP ? avwap : na, "AVWAP", color.new(color.yellow, 0), 2, plot.style_linebr)

// ---------- Dashboard ----------
activeGrids = 1 + (d1OK ? 1 : 0) + (h4OK ? 1 : 0) + (h1OK ? 1 : 0) + (wOK ? 1 : 0)

// default Top right: on TradingView the top-left corner sits under the
// indicator legend, unlike thinkorswim's AddLabel
dashPos = dashPosTxt == "Top right" ? position.top_right : dashPosTxt == "Top left" ? position.top_left : dashPosTxt == "Bottom right" ? position.bottom_right : position.bottom_left

var table dash = showDashboard ? table.new(dashPos, 7, 1) : na

if showDashboard and barstate.islast
    sigActive = bullConfluence or bearConfluence
    bg  = sigActive ? color.new(color.green, 55) : color.new(color.gray, 70)
    txt = color.white
    rsiMark = sigActive ? "✓" : rsiBullOK or rsiBearOK ? "·" : "×"
    htfMark = htfTrendUp ? "▲" : htfTrendDown ? "▼" : "─"
    table.cell(dash, 0, 0, "Score: " + str.tostring(priceConfluenceScore, "0.0"), bgcolor = bg, text_color = txt)
    table.cell(dash, 1, 0, "Time: "  + (isTimeWindow ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 2, 0, "AVWAP: " + (nearAVWAP ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 3, 0, "Fan: "   + (nearFan ? "✓" : "×"), bgcolor = bg, text_color = txt)
    table.cell(dash, 4, 0, "RSI: "   + rsiMark, bgcolor = bg, text_color = txt)
    table.cell(dash, 5, 0, "HTF: "   + htfMark, bgcolor = bg, text_color = txt)
    table.cell(dash, 6, 0, "Grids: " + str.tostring(activeGrids) + "/5", bgcolor = bg, text_color = txt)
